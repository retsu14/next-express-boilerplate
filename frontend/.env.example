# Used only when running Next.js directly on your machine (npm run dev).
# Docker Compose sets these values itself; see ../docker-compose.yaml.
# Copy to .env.local to use it.

# Address the BROWSER uses to call the API. Public: it is embedded in client code.
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Address Server Components use to call the API. Server-only.
# Inside Docker this is http://api:4000/api (a Compose-only hostname).
API_INTERNAL_URL=http://localhost:4000/api

# Never put database credentials or other secrets in NEXT_PUBLIC_* variables.
