# Used only when running the API directly on your machine (npm run dev).
# Docker Compose sets these values itself; see ../docker-compose.yaml.
# LOCAL DEVELOPMENT CREDENTIALS ONLY - never reuse them anywhere else.

HOST=127.0.0.1
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=app
DB_PASSWORD=app_dev_password
DB_NAME=app

# Integration tests only. Must end in _test and differ from DB_NAME.
TEST_DB_NAME=app_test
