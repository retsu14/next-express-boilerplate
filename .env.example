# Read by Docker Compose (copy to .env). Every value has a default in
# docker-compose.yaml, so this file is optional.
#
# LOCAL DEVELOPMENT CREDENTIALS ONLY - never reuse them anywhere else.
# They are applied only when the MySQL data volume is first created;
# changing them later does not change the passwords of an existing database.

MYSQL_ROOT_PASSWORD=root_dev_password
MYSQL_PASSWORD=app_dev_password
